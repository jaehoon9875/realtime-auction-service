# P3 입찰 레이턴시 baseline 부하 설정
#
# ⚠️ 이 파일은 before/after 공용 "고정값"이다. 개선 전/후 측정에서 동일한 값을 써야
#    비교가 공정하다. baseline을 한 번 측정한 뒤로는 값을 바꾸지 말 것.
#
# 무료 크레딧 절약 원칙:
#   - VU·지속시간을 의도적으로 낮게 유지해 노드 오토스케일(=과금 급증)을 회피한다.
#   - 부하는 클러스터 내부(Job → api-gateway-service)에서만 발생 → egress 과금 없음.

# ── 부하 규모 ──────────────────────────────────────────────
# 동시 가상 사용자 최대 수. p95/p99 꼬리 지표가 의미를 갖는 수준으로.
# (이 정도는 기존 파드로 받아내 노드 오토스케일까지 가는 경우가 드묾)
MAX_VUS=50

# ── 단계 구성 ──────────────────────────────────────────────
# RAMPUP 구간은 워밍업(JIT·커넥션 풀·RocksDB 예열) 겸용. 헤드라인 수치는 SUSTAIN 구간이 좌우.
RAMPUP_DUR=30s
SUSTAIN_DUR=5m
RAMPDOWN_DUR=15s

# ── 요청 패턴 ──────────────────────────────────────────────
# 요청 간 think time(초).
SLEEP=0.3

# setup()에서 생성할 경매 수.
AUCTION_COUNT=20

# 입찰 분산 방식: spread(여러 경매에 분산) | single(1개 경매에 집중, 경합 시나리오)
SCENARIO=spread

# setup()에서 생성할 입찰자 계정 수(토큰 풀). VU들이 이 풀을 나눠 쓴다.
BIDDER_COUNT=10
