# 스모크용 초경량 설정 — 파이프라인이 동작하는지만 확인하는 용도.
#
# 측정값으로 쓰지 말 것(VU가 너무 적어 통계적 의미 없음). 오직 다음을 검증:
#   setup(가입→경매생성→CDC 반영 대기) → 입찰 반복 → 요약/결과 파일 생성까지 정상 동작하는지.
#
# 실행:  PERF_CONFIG=perf/config/smoke.env ./perf/run-perf.sh
# 결과는 results/<git-sha>-smoke/ 에 저장된다(본 측정과 섞이지 않음).

MAX_VUS=5
RAMPUP_DUR=10s
SUSTAIN_DUR=30s
RAMPDOWN_DUR=5s
SLEEP=0.5
AUCTION_COUNT=3
SCENARIO=spread
BIDDER_COUNT=2
